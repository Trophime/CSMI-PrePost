{
  "private": true,
  "name": "course-project-dash",
  "description": "The Course Project Dash documentation",
  "version": "2.1.0",
  "license": "AGPL-3.0",
  "author": "The Course Project Dash Team",
  "homepage": "https://github.com/feelpp/course-project-dash#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feelpp/course-project-dash.git"
  },
  "bugs": {
    "url": "https://github.com/feelpp/course-project-dash/issues"
  },
  "contributors": [
    {
      "name": "Christophe Prud'homme",
      "email": "christophe.prudhomme@cemosis.fr"
    }
  ],
  "scripts": {
    "prose": "write-good --parse **/*.adoc",
    "start": "http-server public/ -d -i",
    "antora": "npx antora --stacktrace generate --cache-dir cache --clean site.yml",
    "validate": "npx antora --stacktrace generate --cache-dir cache --generator ./generator/xref-validator.js --clean site.yml",
    "linkcheck": "broken-link-checker --filter-level 3 --recursive --verbose"
  },
  "dependencies": {
    "@antora/cli": "^3.1",
    "@antora/collector-extension": "^1.0.0",
    "@antora/site-generator-default": "^3.1",
    "@asciidoctor/core": "^3.0.4",
    "@feelpp/antora-extensions": "^1.0.0-rc.2",
    "@feelpp/asciidoctor-extensions": "1.0.0-rc.13",
    "@sntke/antora-mermaid-extension": "^0.0.6",
    "asciidoctor": "^3.0.4",
    "asciidoctor-jupyter": "^0.7.0",
    "asciidoctor-kroki": "^0.18.1",
    "handlebars": "^4.7.8",
    "handlebars-utils": "^1.0.6",
    "package.json": "^2.0.1"
  },
  "devDependencies": {
    "broken-link-checker": "^0.7.8",
    "http-server": "^14.1.1",
    "write-good": "^1.0.8"
  },
  "keywords": [
    "antora",
    "asciidoc",
    "documentation"
  ]
}
